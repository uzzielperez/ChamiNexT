# Copy to .env / Netlify env (never commit secrets)

# AI
GROQ_API_KEY=
ELEVENLABS_API_KEY=

# Auth (magic link + Google)
RESEND_API_KEY=
MAGIC_LINK_FROM=ChamiNext <hello@chaminext.com>
JWT_SECRET=
# Google OAuth (Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client)
# Authorized redirect URI:
#   https://YOUR_SITE/.netlify/functions/auth-google-callback
# Local with `netlify dev`:
#   http://localhost:8888/.netlify/functions/auth-google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override if redirect URI differs from the deployed site URL
# GOOGLE_REDIRECT_URI=

# Stripe (founding cohort of ~30 payers)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# From: node scripts/stripe-setup-founding.mjs
STRIPE_FOUNDING_PROMOTION_CODE_ID=

# Optional rate limits
RATE_LIMIT_INTERVIEW=30
RATE_LIMIT_CODERUN=40
RATE_LIMIT_SHIP=20
